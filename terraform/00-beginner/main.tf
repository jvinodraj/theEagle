terraform {
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
  required_version = ">= 1.3.0"
}

provider "local" {}

locals {
  greeting  = "Hello, ${var.your_name}!"
  timestamp = "Generated by Terraform!!!"
}

resource "local_file" "greeting" {
  filename = "${path.module}/greeting.txt"
  content  = "${local.greeting}\n${local.timestamp}\n"
}

resource "local_file" "summary" {
  filename = "${path.module}/summary.txt"
  content  = <<-EOT
    Name    : ${var.your_name}
    Message : ${local.greeting}
    File    : ${local_file.greeting.filename}
  EOT
}
